# Copy this file to ".env" and fill in the values. NEVER commit the real .env.
# Every value here is OPTIONAL. The site builds and runs without any of them.

# Google Analytics 4
# Your GA4 Measurement ID (GA4 > Admin > Data Streams > your web stream).
# The PUBLIC_ prefix is required so Astro exposes it to the browser. A GA4 ID
# is not a secret. Leave blank to keep analytics OFF (nothing is loaded).
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console, HTML tag method: the content="..." value only.
PUBLIC_GSC_VERIFICATION=

# Live Google reviews (build time only)
# Google Cloud Console > enable "Places API (New)" > create an API key and
# restrict it to the Places API. Reviews are fetched at build time, so the key
# never reaches the browser. With no key, the reviews section is left out.
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here
