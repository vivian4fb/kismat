---
import Base from '../layouts/Base.astro';
import { links, withBase } from '../config';
---
<Base title="Page not found" description="We couldn't find that page. Head to the menu or order from Kismat, 52 Gateway Street, Leicester." noindex>
  <section class="page-head on-leaf" style="min-height:60vh;display:grid;align-items:center">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lead">It may have moved, or it may never have existed. The food is still here.</p>
      <div class="btn-row" style="margin-top:1.8rem">
        <a class="btn btn--gold" href={withBase('/menu')}>See the menu</a>
        <a class="btn btn--line" href={withBase('/')}>Back to the homepage</a>
        <a class="btn btn--line" href={links.tel}>Call us</a>
      </div>
    </div>
  </section>
</Base>
