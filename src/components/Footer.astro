---
import { site, links, withBase, addressLine, features, formatTime } from '../config';
import { dishPages } from '../data/dishPages';
import { areaPages } from '../data/areaPages';

const year = new Date().getFullYear();
const explore = [
  { href: '/menu', label: 'Menu' },
  { href: '/order', label: 'Order' },
  { href: '/kerala-food-guide', label: 'Kerala food guide' },
  ...(features.catering ? [{ href: '/catering', label: 'Catering' }] : []),
  ...(features.christmas ? [{ href: '/christmas', label: 'Christmas' }] : []),
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'Questions' },
  { href: '/contact', label: 'Visit' },
];
---
<footer class="site-footer">
  <div class="kasavu" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="wordmark" href={withBase('/')}>KISMAT</a>
      <p>{site.tagline}</p>
      <p>{addressLine}<br /><a href={links.tel}>{site.phoneDisplay}</a></p>
      <p>Mon, Wed, Thu {formatTime('13:00')}–{formatTime('22:00')}<br />Fri, Sat, Sun {formatTime('13:00')}–{formatTime('23:00')}<br />Closed Tuesdays</p>
    </div>
    <div>
      <h2 class="footer-h">Explore</h2>
      <ul class="footer-list">
        {explore.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Kerala dishes</h2>
      <ul class="footer-list">
        {dishPages.map((d) => <li><a href={withBase(`/dishes/${d.slug}`)}>{d.nav}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Near you</h2>
      <ul class="footer-list">
        {areaPages.map((a) => <li><a href={withBase(`/areas/${a.slug}`)}>{a.short}</a></li>)}
        <li><a href={withBase('/areas')}>All delivery areas</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <span>© {year} {site.googleBusinessName}, Leicester</span>
    <span>
      <a href={withBase('/privacy')}>Privacy</a>
      <button type="button" class="linkbtn" data-cookie-settings hidden style="margin-left:1em">Cookie settings</button>
    </span>
  </div>
</footer>
