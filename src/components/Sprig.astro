---
// Curry-leaf sprig, drawn as fine outlines. Decorative only. `class` sets size and colour.
const { class: className } = Astro.props;
const leaf = 'M0 0C9-8 27-9 44 0C27 9 9 8 0 0Z';
const pairs = [0, 1, 2, 3, 4, 5, 6];
---
<svg class={className} viewBox="0 0 240 320" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" focusable="false">
  <path d="M120 318C118 230 122 130 120 22" />
  {pairs.map((i) => {
    const y = 288 - i * 40;
    const scale = 1.25 - i * 0.09;
    return (
      <g>
        <path d={leaf} transform={`translate(120 ${y}) rotate(-34) scale(${scale})`} />
        <path d={leaf} transform={`translate(120 ${y}) rotate(214) scale(${scale})`} />
      </g>
    );
  })}
  <path d={leaf} transform="translate(120 22) rotate(-90) scale(.62)" />
</svg>
